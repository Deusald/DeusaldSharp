<?xml version="1.0" encoding="utf-8"?>
<package xmlns="http://schemas.microsoft.com/packaging/2013/05/nuspec.xsd">
  <metadata>
    <id>DeusaldSharp</id>
    <version>11.1.0</version>
    <title>DeusaldSharp</title>
    <authors>Adam "Deusald" Orliński</authors>
    <license type="expression">MIT</license>
    <licenseUrl>https://licenses.nuget.org/MIT</licenseUrl>
    <readme>README.md</readme>
    <projectUrl>https://github.com/Deusald/DeusaldSharp</projectUrl>
    <description>C# utils that are often useful in game development. Meta-package that references every DeusaldSharp module.</description>
    <copyright>Copyright ©Adam "Deusald" Orliński 2020</copyright>
    <tags>C# Tools Utils</tags>
    <repository type="Git" url="https://github.com/Deusald/DeusaldSharp" commit="a8483d14a40dc337135214fae8e9821c088b7b59" />
    <dependencies>
      <group targetFramework="net10.0">
        <dependency id="DeusaldSharp.Clock" version="11.1.0" include="All" />
        <dependency id="DeusaldSharp.Core" version="11.1.0" include="All" />
        <dependency id="DeusaldSharp.CoRoutines" version="11.1.0" include="All" />
        <dependency id="DeusaldSharp.Glicko" version="11.1.0" include="All" />
        <dependency id="DeusaldSharp.Injector" version="11.1.0" include="All" />
        <dependency id="DeusaldSharp.Messages" version="11.1.0" include="All" />
        <dependency id="DeusaldSharp.Proto" version="11.1.0" include="All" />
        <dependency id="DeusaldSharp.Splines" version="11.1.0" include="All" />
        <dependency id="DeusaldSharp.Vectors" version="11.1.0" include="All" />
      </group>
      <group targetFramework=".NETStandard2.1">
        <dependency id="DeusaldSharp.Clock" version="11.1.0" include="All" />
        <dependency id="DeusaldSharp.Core" version="11.1.0" include="All" />
        <dependency id="DeusaldSharp.CoRoutines" version="11.1.0" include="All" />
        <dependency id="DeusaldSharp.Glicko" version="11.1.0" include="All" />
        <dependency id="DeusaldSharp.Injector" version="11.1.0" include="All" />
        <dependency id="DeusaldSharp.Messages" version="11.1.0" include="All" />
        <dependency id="DeusaldSharp.Proto" version="11.1.0" include="All" />
        <dependency id="DeusaldSharp.Splines" version="11.1.0" include="All" />
        <dependency id="DeusaldSharp.Vectors" version="11.1.0" include="All" />
      </group>
    </dependencies>
  </metadata>
</package>