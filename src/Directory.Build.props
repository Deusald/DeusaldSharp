<Project>

    <Import Project="$([MSBuild]::GetPathOfFileAbove('Directory.Build.props', '$(MSBuildThisFileDirectory)../'))" />

    <!-- Defaults for the library modules. DeusaldSharp.Analyzers and the DeusaldSharp meta-package override what they need. -->
    <PropertyGroup>
        <TargetFrameworks>netstandard2.1;net10.0</TargetFrameworks>
        <LangVersion>9</LangVersion>
        <Nullable>enable</Nullable>
        <RootNamespace>DeusaldSharp</RootNamespace>
        <Title>$(MSBuildProjectName)</Title>
        <PackageId>$(MSBuildProjectName)</PackageId>

        <!-- Symbol packages (.snupkg) next to every .nupkg; NuGet.org gets them automatically on push. -->
        <IncludeSymbols>true</IncludeSymbols>
        <SymbolPackageFormat>snupkg</SymbolPackageFormat>

        <!-- The repository readme is shown on every package page. -->
        <PackageReadmeFile>README.md</PackageReadmeFile>

        <!-- Copy the netstandard2.1 Release build of this module into its own Unity package (UnityPackages/<UnityPackageName>/). -->
        <CopyToUnityPackage>true</CopyToUnityPackage>
        <UnityPackagesDir>$(MSBuildThisFileDirectory)../UnityPackages/</UnityPackagesDir>
        <UnityPackageName>com.deusald.deusaldsharp.$(MSBuildProjectName.Replace('DeusaldSharp.', '').ToLowerInvariant())</UnityPackageName>
    </PropertyGroup>

    <ItemGroup>
        <None Include="$(MSBuildThisFileDirectory)../README.md" Pack="true" PackagePath="/" Visible="false" />
    </ItemGroup>

    <ItemGroup>
        <Compile Include="$(MSBuildThisFileDirectory)InternalsVisibleTo.cs" Link="Properties\InternalsVisibleTo.cs" />
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="JetBrains.Annotations" Version="2025.2.4" />
    </ItemGroup>

</Project>
